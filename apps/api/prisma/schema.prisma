// TopGun Trading — Prisma schema.
//
// This schema is the source of truth for the API's data layer. Shared
// API types in @topgun/types mirror the public shape of these models.
//
// Phase 2: User, Session, Workspace.
// Phase 3: Symbol, Watchlist, WatchlistItem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions     Session[]
  workspaces   Workspace[]
  watchlists   Watchlist[]

  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique

  userAgent        String?
  ipAddress        String?

  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("workspaces")
}

// --------------------------------------------------------------------------
// Phase 3: market data
// --------------------------------------------------------------------------

model Symbol {
  id                String   @id @default(cuid())

  // Provider identity, e.g. "coinbase".
  provider          String
  // Native product/symbol id from the provider, e.g. "BTC-USD".
  providerSymbol    String

  assetClass        String
  baseAsset         String
  quoteAsset        String
  displayName       String

  // Decimal strings — we never round provider precision.
  minPriceIncrement String?
  minSizeIncrement  String?

  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  watchlistItems    WatchlistItem[]

  @@unique([provider, providerSymbol])
  @@map("symbols")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean  @default(false)
  position  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  symbolId    String
  symbol      Symbol    @relation(fields: [symbolId], references: [id], onDelete: Restrict)

  position    Int       @default(0)
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbolId])
  @@index([watchlistId])
  @@map("watchlist_items")
}
