{
  "name": "@topgun/api",
  "version": "0.2.0-phase2",
  "private": true,
  "description": "TopGun Trading API service. NestJS, Postgres (Prisma), Redis-ready, WebSockets-ready.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate || true",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/platform-ws": "^10.4.1",
    "@nestjs/websockets": "^10.4.1",
    "@prisma/client": "^5.18.0",
    "@topgun/config": "workspace:*",
    "@topgun/market-data": "workspace:*",
    "@topgun/trading-rules": "workspace:*",
    "@topgun/types": "workspace:*",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "eslint": "^9.9.0",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
