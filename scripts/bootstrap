#!/usr/bin/env bash
#
# TopGun Trading — one-command local bootstrap.
#
# Installs workspace dependencies, brings up the Docker data stack,
# generates the Prisma client, and applies the initial migration.
# After this runs cleanly, `pnpm dev:api` and `pnpm dev:web` should
# start without further setup.
#
# Re-runnable. Idempotent.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

step() {
  printf "\n\033[1;38;5;208m==> %s\033[0m\n" "$*"
}

step "Checking prerequisites"
command -v pnpm >/dev/null || { echo "pnpm is required. Install from https://pnpm.io/installation"; exit 1; }
command -v docker >/dev/null || { echo "docker is required. Install from https://docs.docker.com/get-docker/"; exit 1; }

step "Installing workspace dependencies"
pnpm install

step "Starting local data services (Postgres, Redis, mailhog)"
docker compose -f infra/docker/docker-compose.yml up -d

step "Waiting for Postgres to accept connections"
until docker exec topgun-postgres pg_isready -U topgun -d topgun >/dev/null 2>&1; do
  printf "."
  sleep 1
done
printf "\n"

step "Ensuring .env files exist"
if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created .env from .env.example. Review it before going further."
fi

step "Building shared packages"
pnpm -r --filter "@topgun/config" --filter "@topgun/types" build

step "Generating the Prisma client"
pnpm --filter @topgun/api prisma:generate

step "Applying Prisma migrations"
pnpm --filter @topgun/api prisma:migrate:deploy

cat <<'EOF'

All set. Next steps:

  pnpm dev:api    # runs the NestJS API on :4000
  pnpm dev:web    # runs the Next.js web on :3000

  pnpm lint
  pnpm typecheck
  pnpm test
  pnpm build

Local services can be stopped with:

  docker compose -f infra/docker/docker-compose.yml down

EOF
