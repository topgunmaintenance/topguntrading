# TopGun Trading — example environment
# Copy this file to .env (and per-app .env files) and fill values.
# Never commit real secrets. .env is gitignored.

# ---- General ----
NODE_ENV=development
APP_NAME=topgun-trading

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Browser-visible. WebSocket URL the web app uses for live quotes.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/stream
# Server-only. How the web's route handlers reach the API.
# Never prefixed NEXT_PUBLIC_ — the browser must not see it.
API_INTERNAL_URL=http://localhost:4000

# ---- API (apps/api) ----
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
API_CORS_ORIGINS=http://localhost:3000

# ---- Worker (apps/worker) ----
WORKER_CONCURRENCY=4

# ---- Database ----
# Postgres URL used by Prisma in apps/api
DATABASE_URL=postgresql://topgun:topgun@localhost:5432/topgun?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Long random string. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string
SESSION_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=2592000

# ---- OAuth providers (optional, Phase 2+) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Mail (dev uses mailhog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@topguntrading.local

# ---- Market data (Phase 3) ----
# Adapter to use for symbol search, candles, and live quotes.
#   mock      — deterministic synthetic data; UI renders a warning banner
#   coinbase  — unauthenticated public Coinbase Exchange endpoints
MARKET_DATA_PROVIDER=mock
MARKET_DATA_CACHE_TTL_SECONDS=60

# Coinbase endpoints (only used when MARKET_DATA_PROVIDER=coinbase).
# No API key is required — we only call public, unauthenticated endpoints.
COINBASE_REST_URL=https://api.exchange.coinbase.com
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# ---- Phase 3.5 — Kraken public API (ADR-0026) ----
# Powers the Whale Activity observational feature on the dashboard.
# Kraken is unauthenticated public REST only; no credentials are sent.
KRAKEN_REST_URL=https://api.kraken.com/0/public
# Default symbol for the whale feed when no query param is provided.
WHALES_DEFAULT_SYMBOL=kraken:XBTUSD

# ---- AI (Phase 5+) ----
# Default provider is Anthropic Claude. Real key lives in the secret store.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_DAILY_TOKEN_BUDGET_PER_USER=200000
AI_MONTHLY_USD_BUDGET_TOTAL=500

# ---- Object storage (Phase 4+) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=topgun-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Observability (Phase 6+) ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Extension (apps/extension) ----
EXTENSION_ID_DEV=
EXTENSION_ID_PROD=
